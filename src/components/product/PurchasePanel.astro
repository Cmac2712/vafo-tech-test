---
import QuantitySelector from "../forms/QuantitySelector.astro";
import PurchaseTypeSelector from "../forms/PurchaseTypeSelector.astro";
import DeliveryFrequencySelect from "../forms/DeliveryFrequencySelect.astro";

interface Props {
  heading?: string;
}

const { heading = "Subscribe & Save 25%!" } = Astro.props;
---

<purchase-panel class="purchase">
  <QuantitySelector min={1} max={10} value={1} />

  <div class="subscribe-panel">
    <h2 class="subscribe-heading">{heading}</h2>
    <PurchaseTypeSelector value="subscription" />
    <div data-delivery-frequency>
      <DeliveryFrequencySelect value={30} />
    </div>
  </div>
</purchase-panel>

<script>
  const isSubscription = (value: string) => value === "subscription";

  class PurchasePanel extends HTMLElement {
    connectedCallback() {
      const frequency = this.querySelector<HTMLElement>("[data-delivery-frequency]");

      this.addEventListener("purchase-type-change", (event) => {
        const { value } = (event as CustomEvent<{ value: string }>).detail;
        if (frequency) frequency.hidden = !isSubscription(value);
      });
    }
  }

  if (!customElements.get("purchase-panel")) {
    customElements.define("purchase-panel", PurchasePanel);
  }
</script>

<style>
  .purchase {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .subscribe-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    background: var(--colour-panel);
    border: 1px solid var(--colour-panel-border);
    border-radius: 6px;
  }

  .subscribe-heading {
    margin: 0;
    font-size: 1rem;
  }
</style>
