---
const links = [
  { label: "Shop", href: "#" },
  { label: "Find your food", href: "#" },
  { label: "About", href: "#" },
  { label: "Blog", href: "#" },
];
---

<header class="site-header">
  <div class="container bar">
    <button
      class="menu-toggle icon-button"
      type="button"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <img src="/images/icons/menu.svg" alt="" width="24" height="24" />
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <a class="logo" href="#" aria-label="Pooch &amp; Mutt home">
      <span class="logo-text">Pooch &amp; Mutt</span>
    </a>

    <div class="actions">
      <a class="icon-button desktop-only" href="#" aria-label="Search">
        <img src="/images/icons/search.svg" alt="" width="22" height="22" />
      </a>
      <a class="icon-button desktop-only" href="#" aria-label="Account">
        <img src="/images/icons/account.svg" alt="" width="22" height="22" />
      </a>
      <a class="icon-button" href="#" aria-label="Basket">
        <img src="/images/icons/basket.svg" alt="" width="22" height="22" />
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.getElementById("primary-nav");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    nav?.classList.toggle("is-open", !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #fff;
    border-bottom: 1px solid var(--colour-border);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 60px;
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu-toggle {
    justify-self: start;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo-mark {
    font-size: 1.4rem;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
  }

  .desktop-only {
    display: none;
  }

  .primary-nav {
    display: none;
    grid-column: 1 / -1;
    padding-block: 0.5rem 1rem;
  }

  .primary-nav.is-open {
    display: block;
  }

  .primary-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav a {
    display: block;
    padding: 0.5rem 0;
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }

    .desktop-only {
      display: inline-flex;
    }

    .primary-nav,
    .primary-nav.is-open {
      display: block;
      grid-column: auto;
      padding: 0;
    }

    .primary-nav ul {
      flex-direction: row;
      gap: 1.5rem;
    }

    .primary-nav a {
      padding: 0;
    }
  }
</style>
